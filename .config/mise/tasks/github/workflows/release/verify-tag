#!/usr/bin/env bash
#MISE description="Refuse to release a tag that is not a version tag on main"
set -euo pipefail

release_tag="${RELEASE_TAG:?RELEASE_TAG is required}"
if [[ ! "$release_tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Release tag $release_tag is not a version tag such as v1.2.3" >&2
  exit 1
fi
if ! git merge-base --is-ancestor "refs/tags/$release_tag^{commit}" origin/main; then
  echo "Release tag $release_tag does not point to a commit on main" >&2
  exit 1
fi
