#!/usr/bin/env bash
#MISE description="Build the extension and zip each browser's bundle for the stores"
set -euo pipefail

release_tag="${RELEASE_TAG:?RELEASE_TAG is required}"
version="$(node -p 'require("./package.json").version')"
if [[ "${release_tag#v}" != "$version" ]]; then
  echo "Release tag $release_tag does not match package.json version $version" >&2
  exit 1
fi

pnpm build
pnpm build:firefox

for browser in chrome firefox; do
  (cd "dist/$browser" && zip -qr "../emote-importer-$browser-$version.zip" .)
done
